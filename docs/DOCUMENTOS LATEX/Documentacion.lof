\babel@toc {spanish}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces La cadena de observación (arriba) y los dos simuladores exploratorios (abajo, en naranja). Los simuladores comparten el relieve de NASADEM pero no alimentan ni validan las mediciones de radar.}}{13}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Geometría de adquisición en un corte perpendicular a la órbita. El alcance inclinado $r$ va del satélite al blanco; $\theta _e$ es el ángulo de elevación en el satélite y $\theta _i$ el de incidencia en el blanco. Se dibuja con Tierra plana por claridad; en la sección~\ref {sec:incidencia} se corrige por la curvatura terrestre.}}{17}{figure.caption.8}%
\contentsline {figure}{\numberline {3}{\ignorespaces Efecto del moteado y del multilook en una escena \emph {sintética} (generada por simulación, no es una imagen NISAR). De izquierda a derecha: superficie verdadera con cinco niveles de retrodispersión; una realización con 1 look; promedio $2\times 2$ y promedio $4\times 4$. Todas las imágenes están en dB con la misma escala de grises.}}{19}{figure.caption.10}%
\contentsline {figure}{\numberline {4}{\ignorespaces Distribución del moteado para $L=1,4,16$. A la izquierda, en escala lineal, la distribución exponencial ($L=1$) es muy asimétrica; a la derecha, en dB, todas quedan casi simétricas pero con una cola larga hacia valores bajos. Cada curva es una simulación de 400\,000 muestras.}}{20}{figure.caption.12}%
\contentsline {figure}{\numberline {5}{\ignorespaces Izquierda: desviación estándar del moteado en dB frente a $L$ (curva exacta y aproximación $4.34/\sqrt {L}$). Derecha: brecha de Jensen debida solo al moteado, que parte de 2.51\,dB para $L=1$ y tiende a cero cuando $L$ crece.}}{21}{figure.caption.13}%
\contentsline {figure}{\numberline {6}{\ignorespaces Incidencia elipsoidal frente a incidencia local. En una ladera que mira al radar el ángulo local es menor que el elipsoidal (más señal y, en casos extremos, \emph {layover}); en la ladera opuesta es mayor y, si llega a $90^\circ $ o más, hay sombra. El GCOV de la Etapa 1 no aplica máscara de sombra/\emph {layover} (\texttt {shadowMaskingApplied = False}).}}{22}{figure.caption.14}%
\contentsline {figure}{\numberline {7}{\ignorespaces Izquierda: $10\log _{10}$ comprime seis órdenes de magnitud en un intervalo de unos 60\,dB. Derecha: el camino inverso, de decibeles a razón lineal (marcados 3\,dB $\to $ 2$\times $, 10\,dB $\to $ 10$\times $).}}{26}{figure.caption.20}%
\contentsline {figure}{\numberline {8}{\ignorespaces El cambio se calcula píxel a píxel entre dos escenas comparables y solo después se interpreta. La interpretación nunca es parte de la medición.}}{27}{figure.caption.25}%
\contentsline {figure}{\numberline {9}{\ignorespaces Distribución de $\Delta \sigma ^0_{dB}$ cuando \emph {no} hay cambio real, solo moteado independiente en cada fecha, para $L=1,4,16$ looks. Simulación de 400\,000 pares.}}{28}{figure.caption.26}%
\contentsline {figure}{\numberline {10}{\ignorespaces Los tres mecanismos básicos de retrodispersión. En cada panel, la flecha azul es la señal incidente; la roja, la parte que regresa hacia el radar.}}{29}{figure.caption.27}%
\contentsline {figure}{\numberline {11}{\ignorespaces Rugosidad crítica de Rayleigh en banda L en función del ángulo de incidencia. Con $\lambda =24$\,cm, a $44^\circ $ resulta $4.2$\,cm: por debajo se comporta como lisa; por encima, como rugosa.}}{30}{figure.caption.30}%
\contentsline {figure}{\numberline {12}{\ignorespaces Contribuciones del dosel y del suelo atenuado al $\sigma ^0$ total del water cloud model. Los parámetros $A$, $B$ y $\sigma ^0_{suelo}$ son valores de ejemplo escogidos para mostrar la forma de las curvas; no están calibrados con datos de campo.}}{31}{figure.caption.32}%
\contentsline {figure}{\numberline {13}{\ignorespaces Correspondencia entre el valor $\gamma ^0_{HH}$ (lineal) y el tono de gris en la figura A. Las marcas de la barra de color son equiespaciadas en $t$, no en $v$.}}{33}{figure.caption.41}%
\contentsline {figure}{\numberline {14}{\ignorespaces Cambios de escala entre las figuras de la Etapa 1. El producto tiene píxeles de 10\,m; las figuras B y B2 usan promedios $2\times 2$ (20\,m); la figura A toma una muestra de 1 cada 50 píxeles sin promediar (cada punto representa 500\,m).}}{33}{figure.caption.42}%
\contentsline {figure}{\numberline {15}{\ignorespaces Ejemplo con valores ilustrativos de potencia lineal en un arreglo de $4\times 4$ píxeles. Los cuatro bloques de $2\times 2$ tienen 4, 2, 4 y 1 píxeles válidos.}}{34}{figure.caption.44}%
\contentsline {figure}{\numberline {16}{\ignorespaces Referencia gaussiana. Se dibuja un histograma gaussiano en dB con la media y la desviación observadas en HH ($-8.055$ y $3.59$\,dB). Para ese caso, el dB de la media lineal caería en $-6.57$\,dB, mucho más a la izquierda que el valor observado, $-3.786$\,dB.}}{36}{figure.caption.48}%
\contentsline {figure}{\numberline {17}{\ignorespaces Esquema de la ventana rectangular y del polígono de la ROI. Dentro del polígono hay píxeles válidos y una franja angosta con \texttt {mask}~$=0$; fuera, píxeles que no se analizan.}}{37}{figure.caption.50}%
\contentsline {figure}{\numberline {18}{\ignorespaces Triángulo formado por el centro de la Tierra $O$, el satélite $S$ y el blanco $T$. Esquema: los ángulos y los lados no están a escala.}}{40}{figure.caption.59}%
\contentsline {figure}{\numberline {19}{\ignorespaces Izquierda: el ángulo de incidencia cambia unos $3^\circ $ a lo largo de la ROI, de $\approx 45.4^\circ $ en el oeste a $\approx 42.3^\circ $ en el este (esquema lineal con la pendiente $-0.049^\circ $/km). Derecha: la corrección de terreno plano $10\log _{10}\cos \theta _i$ varía solo $\approx 0.2$\,dB en ese intervalo ($-1.31$ a $-1.54$\,dB).}}{41}{figure.caption.61}%
\contentsline {figure}{\numberline {20}{\ignorespaces El recorrido de un píxel: de la lectura a la escala en dB. El orden importa: el promedio se hace \emph {antes} de pasar a decibeles.}}{43}{figure.caption.63}%
\contentsline {figure}{\numberline {21}{\ignorespaces Balance de masa en una celda de ancho $\Delta x$. La profundidad $h$ se mide desde el lecho $z_b$ hasta la superficie libre $\eta =z_b+h$. El caudal por metro de ancho $q_x$ entra por un lado y sale por el otro; la lluvia $r$ añade agua por arriba.}}{48}{figure.caption.68}%
\contentsline {figure}{\numberline {22}{\ignorespaces Representación modal en una celda (caso 1D). El campo real (gris) se aproxima con una recta (azul); $W_0$ es la media y $W_{1x}$ controla la inclinación. Los valores en las caras son $W_0\pm \sqrt {3}\,W_{1x}$ (círculos) y en los puntos de Gauss $W_0\pm W_{1x}$ (cuadrados).}}{49}{figure.caption.70}%
\contentsline {figure}{\numberline {23}{\ignorespaces Estructura del problema de Riemann aproximado en una cara. Dos ondas extremas ($S^-$ y $S^+$) separan el estado izquierdo $U_L$, un estado intermedio $U^*$ y el derecho $U_R$.}}{49}{figure.caption.72}%
\contentsline {figure}{\numberline {24}{\ignorespaces Reconstrucción hidrostática en una cara. La celda izquierda está mojada; la derecha, seca y con lecho más alto. La profundidad efectiva del lado derecho es $0$, de modo que no se genera flujo hacia el terreno seco.}}{50}{figure.caption.74}%
\contentsline {figure}{\numberline {25}{\ignorespaces Límite de estabilidad CFL para celdas de 20\,m con $C_{CFL}=0.33$. Con agua muy poco profunda ($h=1$\,cm) el límite sería de $\approx 21$\,s; con $h=1$\,m, de $2.1$\,s; con $h=0.1$\,m y corriente de 0.5\,m/s, de $4.4$\,s.}}{50}{figure.caption.76}%
\contentsline {figure}{\numberline {26}{\ignorespaces Izquierda: coeficiente de fricción $C_f=gn_M^2/h^{1/3}$ en función de la profundidad para tres valores de $n_M$. Derecha: pendiente de fricción con $u=1$\,m/s. Con el mismo $n_M$, la fricción es mucho mayor en láminas delgadas.}}{51}{figure.caption.77}%
\contentsline {figure}{\numberline {27}{\ignorespaces Esquema de la malla. La ROI (verde) y el dominio (azul discontinuo) se proyectan a un CRS métrico; el rectángulo de cálculo (negro) añade dos celdas por lado. La lluvia solo se aplica en los centros de celda (puntos verdes) que caen dentro de la ROI.}}{52}{figure.caption.78}%
\contentsline {figure}{\numberline {28}{\ignorespaces Perfil \texttt {uniform\_balanced} (ilustración con semilla arbitraria): 10 intervalos con tasas que oscilan alrededor de una media de 20\,mm/h, de modo que la suma de la lámina coincide con los 20\,mm prescritos.}}{52}{figure.caption.79}%
\contentsline {figure}{\numberline {29}{\ignorespaces Las etapas conceptuales de la cadena solar y cómo se combinan. La proyección final combina la dirección del Sol, la DNI y la normal del terreno.}}{71}{figure.caption.89}%
\contentsline {figure}{\numberline {30}{\ignorespaces Estructura de la DNI de cielo despejado (como fracción de $I_0$, a nivel del mar) en función del cenit para cuatro valores del turbidez de Linke. Es una ilustración de la forma funcional; la implementación de pvlib añade ajustes y límites adicionales.}}{72}{figure.caption.90}%
\contentsline {figure}{\numberline {31}{\ignorespaces El ángulo $\theta $ entre la normal $\hat n$ y la dirección hacia el Sol $\hat s$ determina la fracción de DNI que incide sobre la superficie, $\cos \theta $. En el ejemplo: pendiente $\beta =25^\circ $, cenit $40^\circ $ y ladera mirando lejos del Sol, con $\theta =65^\circ $.}}{72}{figure.caption.91}%
\contentsline {figure}{\numberline {32}{\ignorespaces Fracción de DNI incidente $\mathop {\mathgroup \symoperators m\acute {a}x}(0,\cos \theta )$ en función de la pendiente para un cenit de $50^\circ $ y tres orientaciones. La ladera que mira al Sol gana al aumentar la pendiente hasta que la normal se alinea con los rayos ($\beta =50^\circ $); la que le da la espalda pierde hasta llegar a cero.}}{73}{figure.caption.92}%
\contentsline {figure}{\numberline {33}{\ignorespaces Terreno sintético (izquierda) y factor geométrico $\mathop {\mathgroup \symoperators m\acute {a}x}(0,\hat n\!\cdot \!\hat s)$ relativo al de un terreno plano (derecha), con el Sol al sureste (azimut $135^\circ $) y a $40^\circ $ de elevación. Resolución de 20\,m.}}{73}{figure.caption.93}%
\contentsline {figure}{\numberline {34}{\ignorespaces Elevación solar a lo largo del día para tres fechas ilustrativas a $16.8^\circ $\,N. La curva de verano casi llega al cenit; la de invierno es más baja y más corta.}}{75}{figure.caption.95}%
\contentsline {figure}{\numberline {35}{\ignorespaces Ilustración geométrica de la desigualdad de Jensen para el logaritmo: la cuerda que une dos puntos de la curva queda por debajo de ella, de modo que el promedio de los $10\log _{10}$ (cuadrado) es menor que el $10\log _{10}$ del promedio (círculo).}}{78}{figure.caption.97}%
\contentsline {figure}{\numberline {36}{\ignorespaces Dos rayos reflejados en alturas distintas (diferencia $h$). La diferencia de recorrido es $2h\cos \theta _i$; el criterio de Rayleigh exige que sea menor que $\lambda /4$.}}{79}{figure.caption.98}%
\contentsline {figure}{\numberline {37}{\ignorespaces Solución analítica de Ritter para $h_0=1$\,m: perfil de profundidad a tres tiempos. El frente seco avanza a $2\sqrt {gh_0}=6.26$\,m/s y la onda de rarefacción retrocede a $-\sqrt {gh_0}$.}}{81}{figure.caption.99}%
