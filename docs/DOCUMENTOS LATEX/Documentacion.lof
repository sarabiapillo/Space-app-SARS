\babel@toc {spanish}{}\relax 
\contentsline {figure}{\numberline {1}{\ignorespaces La cadena de observación (arriba) y los dos simuladores exploratorios (abajo, en naranja). Los simuladores comparten el relieve de NASADEM pero no alimentan ni validan las mediciones de radar.}}{18}{figure.caption.4}%
\contentsline {figure}{\numberline {2}{\ignorespaces Geometría de adquisición en un corte perpendicular a la órbita. El alcance inclinado $r$ va del satélite al blanco; $\theta _e$ es el ángulo de elevación en el satélite y $\theta _i$ el de incidencia en el blanco. Se dibuja con Tierra plana por claridad; en la sección~\ref {sec:incidencia} se corrige por la curvatura terrestre.}}{22}{figure.caption.8}%
\contentsline {figure}{\numberline {3}{\ignorespaces Efecto del moteado y del multilook en una escena \emph {sintética} (generada por simulación, no es una imagen NISAR). De izquierda a derecha: superficie verdadera con cinco niveles de retrodispersión; una realización con 1 look; promedio $2\times 2$ y promedio $4\times 4$. Todas las imágenes están en dB con la misma escala de grises.}}{24}{figure.caption.10}%
\contentsline {figure}{\numberline {4}{\ignorespaces Distribución del moteado para $L=1,4,16$. A la izquierda, en escala lineal, la distribución exponencial ($L=1$) es muy asimétrica; a la derecha, en dB, todas quedan casi simétricas pero con una cola larga hacia valores bajos. Cada curva es una simulación de 400\,000 muestras.}}{25}{figure.caption.12}%
\contentsline {figure}{\numberline {5}{\ignorespaces Izquierda: desviación estándar del moteado en dB frente a $L$ (curva exacta y aproximación $4.34/\sqrt {L}$). Derecha: brecha de Jensen debida solo al moteado, que parte de 2.51\,dB para $L=1$ y tiende a cero cuando $L$ crece.}}{26}{figure.caption.13}%
\contentsline {figure}{\numberline {6}{\ignorespaces Incidencia elipsoidal frente a incidencia local. En una ladera que mira al radar el ángulo local es menor que el elipsoidal (más señal y, en casos extremos, \emph {layover}); en la ladera opuesta es mayor y, si llega a $90^\circ $ o más, hay sombra. El GCOV de la Etapa 1 no aplica máscara de sombra/\emph {layover} (\texttt {shadowMaskingApplied = False}).}}{27}{figure.caption.14}%
\contentsline {figure}{\numberline {7}{\ignorespaces Izquierda: $10\log _{10}$ comprime seis órdenes de magnitud en un intervalo de unos 60\,dB. Derecha: el camino inverso, de decibeles a razón lineal (marcados 3\,dB $\to $ 2$\times $, 10\,dB $\to $ 10$\times $).}}{31}{figure.caption.20}%
\contentsline {figure}{\numberline {8}{\ignorespaces Flujo de cálculo de cambio en TerraPulse AI: el Multilook se aplica en potencia lineal sobre cada fecha comparable antes de restar en dB y estandarizar con estadísticas robustas. La interpretación física nunca forma parte de la medición.}}{33}{figure.caption.23}%
\contentsline {figure}{\numberline {9}{\ignorespaces Visualización del mapa de cambio $\Delta \ensuremath {\gamma ^{0}}_{\mathrm {dB}}$ en la interfaz web de TerraPulse AI (modo \textbf {Cambio $\Delta $}) sobre una ROI en Chiapas. La paleta divergente azul--blanco--rojo ($-6\,\mathrm {dB}$ a $+6\,\mathrm {dB}$) muestra espacialmente las zonas donde la retrodispersión disminuyó (azul), permaneció estable (blanco) o aumentó (rojo) entre $t_1$ y $t_2$.}}{34}{figure.caption.24}%
\contentsline {figure}{\numberline {10}{\ignorespaces Distribución teórica de $\Delta \sigma ^0_{\mathrm {dB}}$ cuando \emph {no} hay cambio real en el terreno, solo moteado independiente en cada fecha, para $L=1,4,16$ looks equivalentes. Simulación de 400\,000 pares.}}{34}{figure.caption.25}%
\contentsline {figure}{\numberline {11}{\ignorespaces Panel lateral de controles y métricas del mapa de cambio (\nolinkurl {ChangeControls.tsx}) junto con las estadísticas de la ROI. Muestra las áreas que bajan ($\downarrow $) o suben ($\uparrow $) más que el umbral $\tau _{\mathrm {dB}}$, la mediana $m_{\Delta }$, los selectores de resolución Multilook ($20/50/100\,\mathrm {m}$) y umbral ($\pm 1.5$ a $\pm 6\,\mathrm {dB}$), el piso de ruido medido $\sigma _{\mathrm {MAD}}$, la razón $\tau _{\mathrm {dB}}/\sigma _{\mathrm {MAD}}$, el porcentaje con $|z_{\mathrm {rob}}|>3$ y el aviso automático cuando $\tau _{\mathrm {dB}} < 3\,\sigma _{\mathrm {MAD}}$.}}{36}{figure.caption.27}%
\contentsline {figure}{\numberline {12}{\ignorespaces Los tres mecanismos básicos de retrodispersión. En cada panel, la flecha azul es la señal incidente; la roja, la parte que regresa hacia el radar.}}{38}{figure.caption.28}%
\contentsline {figure}{\numberline {13}{\ignorespaces Rugosidad crítica de Rayleigh en banda L en función del ángulo de incidencia. Con $\lambda =24$\,cm, a $44^\circ $ resulta $4.2$\,cm: por debajo se comporta como lisa; por encima, como rugosa.}}{39}{figure.caption.31}%
\contentsline {figure}{\numberline {14}{\ignorespaces Contribuciones del dosel y del suelo atenuado al $\sigma ^0$ total del water cloud model. Los parámetros $A$, $B$ y $\sigma ^0_{suelo}$ son valores de ejemplo escogidos para mostrar la forma de las curvas; no están calibrados con datos de campo.}}{40}{figure.caption.33}%
\contentsline {figure}{\numberline {15}{\ignorespaces Correspondencia entre el valor $\gamma ^0_{HH}$ (lineal) y el tono de gris en la figura A. Las marcas de la barra de color son equiespaciadas en $t$, no en $v$.}}{42}{figure.caption.42}%
\contentsline {figure}{\numberline {16}{\ignorespaces Cambios de escala entre las figuras de la Etapa 1. El producto tiene píxeles de 10\,m; las figuras B y B2 usan promedios $2\times 2$ (20\,m); la figura A toma una muestra de 1 cada 50 píxeles sin promediar (cada punto representa 500\,m).}}{43}{figure.caption.43}%
\contentsline {figure}{\numberline {17}{\ignorespaces Ejemplo con valores ilustrativos de potencia lineal en un arreglo de $4\times 4$ píxeles. Los cuatro bloques de $2\times 2$ tienen 4, 2, 4 y 1 píxeles válidos.}}{43}{figure.caption.45}%
\contentsline {figure}{\numberline {18}{\ignorespaces Referencia gaussiana. Se dibuja un histograma gaussiano en dB con la media y la desviación observadas en HH ($-8.055$ y $3.59$\,dB). Para ese caso, el dB de la media lineal caería en $-6.57$\,dB, mucho más a la izquierda que el valor observado, $-3.786$\,dB.}}{45}{figure.caption.49}%
\contentsline {figure}{\numberline {19}{\ignorespaces Esquema de la ventana rectangular y del polígono de la ROI. Dentro del polígono hay píxeles válidos y una franja angosta con \texttt {mask}~$=0$; fuera, píxeles que no se analizan.}}{47}{figure.caption.51}%
\contentsline {figure}{\numberline {20}{\ignorespaces Triángulo formado por el centro de la Tierra $O$, el satélite $S$ y el blanco $T$. Esquema: los ángulos y los lados no están a escala.}}{50}{figure.caption.60}%
\contentsline {figure}{\numberline {21}{\ignorespaces Izquierda: el ángulo de incidencia cambia unos $3^\circ $ a lo largo de la ROI, de $\approx 45.4^\circ $ en el oeste a $\approx 42.3^\circ $ en el este (esquema lineal con la pendiente $-0.049^\circ $/km). Derecha: la corrección de terreno plano $10\log _{10}\cos \theta _i$ varía solo $\approx 0.2$\,dB en ese intervalo ($-1.31$ a $-1.54$\,dB).}}{50}{figure.caption.62}%
\contentsline {figure}{\numberline {22}{\ignorespaces El recorrido de un píxel: de la lectura a la escala en dB. El orden importa: el promedio se hace \emph {antes} de pasar a decibeles.}}{52}{figure.caption.64}%
\contentsline {figure}{\numberline {23}{\ignorespaces Balance de masa en una celda de ancho $\Delta x$. La profundidad $h$ se mide desde el lecho $z_b$ hasta la superficie libre $\eta =z_b+h$. El caudal por metro de ancho $q_x$ entra por un lado y sale por el otro; la lluvia $r$ añade agua por arriba.}}{57}{figure.caption.69}%
\contentsline {figure}{\numberline {24}{\ignorespaces Representación modal en una celda (caso 1D). El campo real (gris) se aproxima con una recta (azul); $W_0$ es la media y $W_{1x}$ controla la inclinación. Los valores en las caras son $W_0\pm \sqrt {3}\,W_{1x}$ (círculos) y en los puntos de Gauss $W_0\pm W_{1x}$ (cuadrados).}}{58}{figure.caption.71}%
\contentsline {figure}{\numberline {25}{\ignorespaces Estructura del problema de Riemann aproximado en una cara. Dos ondas extremas ($S^-$ y $S^+$) separan el estado izquierdo $U_L$, un estado intermedio $U^*$ y el derecho $U_R$.}}{58}{figure.caption.73}%
\contentsline {figure}{\numberline {26}{\ignorespaces Reconstrucción hidrostática en una cara. La celda izquierda está mojada; la derecha, seca y con lecho más alto. La profundidad efectiva del lado derecho es $0$, de modo que no se genera flujo hacia el terreno seco.}}{59}{figure.caption.75}%
\contentsline {figure}{\numberline {27}{\ignorespaces Límite de estabilidad CFL para celdas de 20\,m con $C_{CFL}=0.33$. Con agua muy poco profunda ($h=1$\,cm) el límite sería de $\approx 21$\,s; con $h=1$\,m, de $2.1$\,s; con $h=0.1$\,m y corriente de 0.5\,m/s, de $4.4$\,s.}}{59}{figure.caption.77}%
\contentsline {figure}{\numberline {28}{\ignorespaces Izquierda: coeficiente de fricción $C_f=gn_M^2/h^{1/3}$ en función de la profundidad para tres valores de $n_M$. Derecha: pendiente de fricción con $u=1$\,m/s. Con el mismo $n_M$, la fricción es mucho mayor en láminas delgadas.}}{60}{figure.caption.78}%
\contentsline {figure}{\numberline {29}{\ignorespaces Esquema de la malla. La ROI (verde) y el dominio (azul discontinuo) se proyectan a un CRS métrico; el rectángulo de cálculo (negro) añade dos celdas por lado. La lluvia solo se aplica en los centros de celda (puntos verdes) que caen dentro de la ROI.}}{61}{figure.caption.79}%
\contentsline {figure}{\numberline {30}{\ignorespaces Perfil \texttt {uniform\_balanced} (ilustración con semilla arbitraria): 10 intervalos con tasas que oscilan alrededor de una media de 20\,mm/h, de modo que la suma de la lámina coincide con los 20\,mm prescritos.}}{61}{figure.caption.80}%
\contentsline {figure}{\numberline {31}{\ignorespaces Las etapas conceptuales de la cadena solar y cómo se combinan. La proyección final combina la dirección del Sol, la DNI y la normal del terreno.}}{80}{figure.caption.90}%
\contentsline {figure}{\numberline {32}{\ignorespaces Estructura de la DNI de cielo despejado (como fracción de $I_0$, a nivel del mar) en función del cenit para cuatro valores del turbidez de Linke. Es una ilustración de la forma funcional; la implementación de pvlib añade ajustes y límites adicionales.}}{81}{figure.caption.91}%
\contentsline {figure}{\numberline {33}{\ignorespaces El ángulo $\theta $ entre la normal $\hat n$ y la dirección hacia el Sol $\hat s$ determina la fracción de DNI que incide sobre la superficie, $\cos \theta $. En el ejemplo: pendiente $\beta =25^\circ $, cenit $40^\circ $ y ladera mirando lejos del Sol, con $\theta =65^\circ $.}}{81}{figure.caption.92}%
\contentsline {figure}{\numberline {34}{\ignorespaces Fracción de DNI incidente $\mathop {\mathgroup \symoperators m\acute {a}x}(0,\cos \theta )$ en función de la pendiente para un cenit de $50^\circ $ y tres orientaciones. La ladera que mira al Sol gana al aumentar la pendiente hasta que la normal se alinea con los rayos ($\beta =50^\circ $); la que le da la espalda pierde hasta llegar a cero.}}{82}{figure.caption.93}%
\contentsline {figure}{\numberline {35}{\ignorespaces Terreno sintético (izquierda) y factor geométrico $\mathop {\mathgroup \symoperators m\acute {a}x}(0,\hat n\!\cdot \!\hat s)$ relativo al de un terreno plano (derecha), con el Sol al sureste (azimut $135^\circ $) y a $40^\circ $ de elevación. Resolución de 20\,m.}}{82}{figure.caption.94}%
\contentsline {figure}{\numberline {36}{\ignorespaces Elevación solar a lo largo del día para tres fechas ilustrativas a $16.8^\circ $\,N. La curva de verano casi llega al cenit; la de invierno es más baja y más corta.}}{84}{figure.caption.96}%
\contentsline {figure}{\numberline {37}{\ignorespaces Cadena de procesamiento en cliente del módulo de Relieve 3D (\nolinkurl {web/src/utils/terrain3d.ts}). La conversión de canales RGB a metros ocurre a resolución nativa $1:1$ antes de cualquier interpolación espacial.}}{86}{figure.caption.98}%
\contentsline {figure}{\numberline {38}{\ignorespaces Maqueta topográfica interactiva en el visor de Relieve 3D (\texttt {Terrain3DViewer}) con textura \emph {Satelital (Esri World Imagery)}, exageración vertical de $2.0\times $, zócalo delgado en gris pizarra y panel lateral de controles y telemetría ($\Delta z$, $h_{\mathop {\mathgroup \symoperators m\acute {\dotlessi }n}}$, $h_{\mathop {\mathgroup \symoperators m\acute {a}x}}$, extensión y zoom de teselas).}}{89}{figure.caption.99}%
\contentsline {figure}{\numberline {39}{\ignorespaces La misma ROI representada en modo \emph {Hipsométrico (Elevación)} dentro del visor 3D. El azul costero delimita los cuerpos de agua a $0\,\mathrm {m}$, mientras la rampa altitudinal y el sombreado Lambertiano~\eqref {eq:lambert-hillshade} destacan las divisorias de cuenca y los cañones.}}{90}{figure.caption.100}%
\contentsline {figure}{\numberline {40}{\ignorespaces Modo \emph {Máscara SAR (Geometría)} sobre el relieve 3D en órbita \textbf {Ascendente (T62/F10)}. En verde se observan los valles y planicies confiables ($\alpha \le 15^\circ $), en ámbar las laderas de pendiente crítica ($>15^\circ $), y en rojo/morado las paredes del cañón afectadas por \emph {layover} y sombra.}}{92}{figure.caption.102}%
\contentsline {figure}{\numberline {41}{\ignorespaces Inversión geométrica al conmutar a órbita \textbf {Descendente (T55/F80)} en el subpanel del visor 3D. Las laderas orientadas al oeste/este invierten sus regiones de \emph {layover} (rojo) y sombra radar (morado oscuro), actualizando en vivo los porcentajes de la leyenda.}}{93}{figure.caption.103}%
\contentsline {figure}{\numberline {42}{\ignorespaces Ilustración geométrica de la desigualdad de Jensen para el logaritmo: la cuerda que une dos puntos de la curva queda por debajo de ella, de modo que el promedio de los $10\log _{10}$ (cuadrado) es menor que el $10\log _{10}$ del promedio (círculo).}}{95}{figure.caption.104}%
\contentsline {figure}{\numberline {43}{\ignorespaces Dos rayos reflejados en alturas distintas (diferencia $h$). La diferencia de recorrido es $2h\cos \theta _i$; el criterio de Rayleigh exige que sea menor que $\lambda /4$.}}{95}{figure.caption.105}%
\contentsline {figure}{\numberline {44}{\ignorespaces Solución analítica de Ritter para $h_0=1$\,m: perfil de profundidad a tres tiempos. El frente seco avanza a $2\sqrt {gh_0}=6.26$\,m/s y la onda de rarefacción retrocede a $-\sqrt {gh_0}$.}}{98}{figure.caption.106}%
\contentsline {figure}{\numberline {45}{\ignorespaces Cadena de procesamiento en cliente del módulo de Relieve 3D (\nolinkurl {web/src/utils/terrain3d.ts}). La conversión de canales RGB a metros ocurre a resolución nativa $1:1$ antes de cualquier interpolación espacial.}}{115}{figure.caption.198}%
\contentsline {figure}{\numberline {46}{\ignorespaces Maqueta topográfica interactiva en el visor de Relieve 3D (\texttt {Terrain3DViewer}) con textura \emph {Satelital (Esri World Imagery)}, exageración vertical de $2.0\times $, zócalo delgado en gris pizarra y panel lateral de controles y telemetría ($\Delta z$, $h_{\mathop {\mathgroup \symoperators m\acute {\dotlessi }n}}$, $h_{\mathop {\mathgroup \symoperators m\acute {a}x}}$, extensión y zoom de teselas).}}{118}{figure.caption.199}%
\contentsline {figure}{\numberline {47}{\ignorespaces La misma ROI representada en modo \emph {Hipsométrico (Elevación)} dentro del visor 3D. El azul costero delimita los cuerpos de agua a $0\,\mathrm {m}$, mientras la rampa altitudinal y el sombreado Lambertiano~\eqref {eq:lambert-hillshade} destacan las divisorias de cuenca y los cañones.}}{119}{figure.caption.200}%
\contentsline {figure}{\numberline {48}{\ignorespaces Modo \emph {Máscara SAR (Geometría)} sobre el relieve 3D en órbita \textbf {Ascendente (T62/F10)}. En verde se observan los valles y planicies confiables ($\alpha \le 15^\circ $), en ámbar las laderas de pendiente crítica ($>15^\circ $), y en rojo/morado las paredes del cañón afectadas por \emph {layover} y sombra.}}{121}{figure.caption.202}%
\contentsline {figure}{\numberline {49}{\ignorespaces Inversión geométrica al conmutar a órbita \textbf {Descendente (T55/F80)} en el subpanel del visor 3D. Las laderas orientadas al oeste/este invierten sus regiones de \emph {layover} (rojo) y sombra radar (morado oscuro), actualizando en vivo los porcentajes de la leyenda.}}{122}{figure.caption.203}%
\contentsline {figure}{\numberline {50}{\ignorespaces Cadena de cálculo del simulador sísmico en cliente (\nolinkurl {web/src/utils/seismic.ts} y \nolinkurl {web/src/utils/signal.ts}).}}{123}{figure.caption.204}%
\contentsline {figure}{\numberline {51}{\ignorespaces Panel y modal del simulador sísmico mostrando la curva 2D de atenuación $\mathrm {PGA}(D)$ frente a la distancia epicentral, el intervalo de incertidumbre logarítmica ($16\text {--}84\,\text {\char 37}$), el momento sísmico $M_0$ y los avisos automáticos de dominio de validez del modelo GMPE seleccionado.}}{126}{figure.caption.209}%
\contentsline {figure}{\numberline {52}{\ignorespaces Simulación visual 2D sobre MapLibre GL mostrando los cuatro anillos geodésicos de isosisma ($\mathrm {MMI}$), la propagación concéntrica en tiempo real de los frentes de onda $P$ (azul, $V_p=6.0\,\mathrm {km/s}$) y $S$ (rojo, $V_s=3.5\,\mathrm {km/s}$) según la ecuación~\eqref {eq:radio-frente-superficie}, el epicentro interactivo y la estación receptora seleccionada en el mapa.}}{127}{figure.caption.210}%
\contentsline {figure}{\numberline {53}{\ignorespaces Vista acoplada de la serie temporal del acelerograma sintético $a(t)$ muestreado a $50\,\mathrm {Hz}$ (arriba) y su espectrograma tiempo-frecuencia STFT con ventana de Hann en escala \emph {Inferno} de $60\,\mathrm {dB}$ (abajo). Se distinguen las dos bandas laterales de la onda $P$ ($3.8$ y $5.2\,\mathrm {Hz}$ entre $t_p$ y $t_s$) y la concentración energética de baja frecuencia tras el arribo de la onda $S$, junto con las métricas $f_{\mathrm {dom}}$ y $D_{5\text {--}95}$.}}{130}{figure.caption.213}%
\contentsline {figure}{\numberline {54}{\ignorespaces Arquitectura desacoplada de cuatro capas de TerraPulse AI. El pipeline científico (\nolinkurl {pipeline/}) no importa ningún módulo del servidor web; la comunicación ocurre a través de contratos en disco y tablas espaciales en PostGIS.}}{132}{figure.caption.214}%
\contentsline {figure}{\numberline {55}{\ignorespaces Diagrama integral de la arquitectura de software de TerraPulse AI, mostrando el flujo de datos desde los repositorios de NASA Earthdata (ASF Vertex y LP DAAC) hasta el backend en Python (Django/DRF), el contenedor PostgreSQL 16 + PostGIS 3.4 en Docker y los módulos interactivos del frontend en React/Vite.}}{132}{figure.caption.215}%
\contentsline {figure}{\numberline {56}{\ignorespaces Inspección de los contratos JSON de la API REST de TerraPulse AI (\texttt {/api/scenes}, \texttt {/api/roi-jobs} y \texttt {/api/solar/simulations}), mostrando las cabeceras HTTP, los campos de trazabilidad (\texttt {code\_version}, \texttt {warnings}) y las respuestas GeoJSON/métricas estructuradas.}}{142}{figure.caption.222}%
\contentsline {figure}{\numberline {57}{\ignorespaces Contenedor PostgreSQL 16 + PostGIS 3.4 en ejecución mediante Docker Compose y consulta de verificación sobre las tablas espaciales \texttt {scenes\_roi}, \texttt {scenes\_scene}, \texttt {scenes\_sceneinspection} y \texttt {scenes\_scenechart}.}}{144}{figure.caption.224}%
\contentsline {figure}{\numberline {58}{\ignorespaces Panel interactivo del \textbf {Simulador Solar \& Radiación} en la interfaz web de TerraPulse AI, mostrando el mapa de calor de irradiancia directa incidente ($G_i$ en $\mathrm {W/m^2}$) sobre el relieve NASADEM con paleta \emph {Inferno}, el conmutador de escala \textbf {Contraste ($p_2\text {--}p_{98}$)} / \textbf {Absoluta ($0\text {--}\mathrm {DNI}$)} y el tablero de telemetría solar (elevación aparente SPA, DNI de cielo despejado y ajustado, mediana y rango de irradiancia sobre la ROI).}}{148}{figure.caption.225}%
