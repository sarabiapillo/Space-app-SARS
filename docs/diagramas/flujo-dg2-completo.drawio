<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-16T00:00:00.000Z" agent="local-matplotlib" version="24.7.17" type="device"><diagram id="dg2-roi" name="Flujo DG2 completo"><mxGraphModel dx="3400" dy="7864" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="7864" math="1" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="header" value="DG2 · De la ROI a la API del front" style="text;html=1;align=left;verticalAlign=middle;fontSize=44;fontStyle=1;fontColor=#143154;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="55" width="2940" height="95" /></mxCell><mxCell id="subtitle" value="Un flujo · ecuaciones, métodos y frontera backend/frontend" style="text;html=1;align=left;fontSize=23;fontColor=#36536c;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="148" width="2940" height="65" /></mxCell><mxCell id="p1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;01 · Solicitud frontend → backend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;POST /api/flood-scenarios/roi/start/ · RoiRunStartView&lt;/font&gt;&lt;br&gt;Sesión autenticada + ROI/domain GeoJSON 4326; lluvia/perfil, terreno, hidráulica y simulación.&lt;br&gt;La lluvia es hipotética: no es lluvia medida ni profundidad inferida de NISAR.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e8f1fc;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="260" width="2940" height="261" /></mxCell><mxCell id="p2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;02 · Admisión y bifurcación&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;validate_roi_run → start_roi_run · pipeline/hydrology/roi_runner.py&lt;/font&gt;&lt;br&gt;Dominio cubre ROI; CRS métrico, cobertura NASADEM −56°…60°, presupuestos y siete secciones.&lt;br&gt;Manning explícito; dry_zero_velocity; closed/free; domain_nonurban declarado; infiltración unsupported.&lt;br&gt;Inválido: 400 / servicio: 503 SIN trabajo. Válido: 202 + UUID privado; worker fuera del request.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e8f1fc;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="603" width="2940" height="309" /></mxCell><mxCell id="p3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;03 · Elevación y malla&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;NASADEMProvider.acquire_roi → _prepare · nasadem.py / roi_runner.py&lt;/font&gt;&lt;br&gt;HGT NASADEM EGM96: z_b elevación (m), NO profundidad; teselas y cobertura real verificadas.&lt;br&gt;Rectángulo proyectado alineado y expandido; dem_prepared; malla completa finita.&lt;br&gt;Nodata ≠ 0. Ausencia, hueco o adquisición fallida → failed; no se inventa terreno.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e8f1fc;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="994" width="2940" height="309" /></mxCell><mxCell id="p4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;04 · Proyección modal del lecho&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;prepare_dg2_dem → generateDG2DEM · dem_dg2.py / preprocess/generateDG2DEM.cpp&lt;/font&gt;&lt;br&gt;$$z_0=(NW+NE+SW+SE)/4$$&lt;br&gt;$$z_{1x}=(NE+SE-NW-SW)/(4\sqrt{3}),\quad z_{1y}=(NE+NW-SE-SW)/(4\sqrt{3})$$&lt;br&gt;Salidas .dem / .dem1x / .dem1y; coeficientes en m (NO pendientes m/m).&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="1385" width="2940" height="381" /></mxCell><mxCell id="p5" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;05 · Lluvia sintética reproducible&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;generate_rainfall_profile · rainfall.py&lt;/font&gt;&lt;br&gt;$$\bar r=P/T_r,\quad\delta=\min(\bar r,10/(1000\cdot3600))\ {\rm m/s}$$&lt;br&gt;$$r_k=\bar r\pm d_j\ (\text{pares con semilla}),\quad\sum_k r_k\Delta t_r=P$$&lt;br&gt;Tasa uniforme en centros de ROI; fuera = 0. P en m; intervalos en s; perfil equilibrado nominal.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="1848" width="2940" height="381" /></mxCell><mxCell id="p6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;06 · NetCDF de lluvia + borde e inicio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;export_rainfall_netcdf / format_free_boundary · rainfall_netcdf.py / boundaries.py&lt;/font&gt;&lt;br&gt;$$R_k=1000r_k\Delta t_r\ {\rm mm};\quad t_h=t_s/3600;\quad r_k=R_k/(1000\cdot3600\Delta t_h)$$&lt;br&gt;NetCDF3 rainfall_depth(time,y,x) mm/intervalo; centros métricos, y descendente, cola seca.&lt;br&gt;h=qₓ=qᵧ=0 al inicio. closed: reflexión; FREE idealizada puede entrar o salir.&lt;br&gt;roi.par: dg2, DEM, lluvia, Manning, borde, tiempos; entradas/binario fijados con hashes y plazo.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="2311" width="2940" height="393" /></mxCell><mxCell id="p7" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;07 · Modelo físico del núcleo DG2&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;swe/flux.cpp · physical_flux_x/y; swe/dg2.cpp · L0/L1x/L1y&lt;/font&gt;&lt;br&gt;$$U=(h,q_x,q_y)^T,\quad q_x=hu,\ q_y=hv,\quad \eta=z_b+h$$&lt;br&gt;$$\partial_tU+\partial_xF(U)+\partial_yG(U)=S_b+S_f+(r,0,0)^T$$&lt;br&gt;$$F=(q_x,q_x^2/h+gh^2/2,q_xq_y/h)^T$$&lt;br&gt;$$G=(q_y,q_xq_y/h,q_y^2/h+gh^2/2)^T;\quad S_b=(0,-ghz_{b,x},-ghz_{b,y})^T$$&lt;br&gt;h y z_b en m; q en m²/s; r en m/s. Cocientes solo en estado húmedo.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="2786" width="2940" height="549" /></mxCell><mxCell id="p8" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;08 · Grados de libertad en cada celda&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;swe/dg2/modifiedvars.cpp / swe/dg2.cpp&lt;/font&gt;&lt;br&gt;$$W_h=W_0+\sqrt{3} W_{1x}\xi+\sqrt{3} W_{1y}\zeta,\quad W\in\{h,q_x,q_y,z_b\}$$&lt;br&gt;$$\xi=2(x-x_i)/\Delta x,\quad\zeta=2(y-y_j)/\Delta y\quad(\text{adimensionales})$$&lt;br&gt;Tres modos por campo; L0/L1x/L1y incluyen caras, Gauss y fuente de lecho.&lt;br&gt;Limitador de pendientes disponible, desactivado por defecto; infiltración NO aplicada.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="3417" width="2940" height="429" /></mxCell><mxCell id="p9" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;09 · Ciclo: condición y lluvia PRIMERO&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;swe/dg2.cpp · dg2::solve → rain.update_H · rain/rain.tpp&lt;/font&gt;&lt;br&gt;Si t &amp;lt; Sim_Time: leer tasa NetCDF, aplicar h ← h + r·Δt VIGENTE.&lt;br&gt;Luego actualizar frontera; esta API no configura fuentes puntuales.&lt;br&gt;La lluvia precede al recálculo del paso CFL: NO se certifica balance global.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="3928" width="2940" height="309" /></mxCell><mxCell id="p10" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;10 · Paso adaptativo y fricción fuera de RK&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;Tstep_from_cfl / apply_friction · swe/dg2.cpp / swe/dg2/friction.cpp&lt;/font&gt;&lt;br&gt;$$\Delta t\leq\min(\Delta t_{init},\ C_{CFL}\Delta x/(|u|+\sqrt{gh}),\ C_{CFL}\Delta y/(|v|+\sqrt{gh}))$$&lt;br&gt;$$C_{CFL}=0.33\ (\text{default}),\quad C_f=gn_M^2/h^{1/3},\quad w=\sqrt{u^2+v^2}$$&lt;br&gt;$$D_x=1+\Delta t(C_f/h)(2u^2+v^2)/w,\quad D_y=1+\Delta t(C_f/h)(u^2+2v^2)/w$$&lt;br&gt;$$q_x\leftarrow q_x-\Delta t C_fuw/D_x,\quad q_y\leftarrow q_y-\Delta t C_fvw/D_y$$&lt;br&gt;nₘ: s/m^(1/3); estados secos / velocidad baja protegidos; fricción separada de RK.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="4319" width="2940" height="549" /></mxCell><mxCell id="p11" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;11 · Caras húmedas/secas y flujo numérico&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;modifiedvars.cpp → hll_include.h / flux.cpp · update_fluxes&lt;/font&gt;&lt;br&gt;$$z^*=\max(z_L,z_R),\quad h^*_{L,R}=\max(0,\eta_{L,R}-z^*)$$&lt;br&gt;$$q^*=h^*(q/h)\quad (\mathrm{si\ humedo});\qquad\widehat F^{(h,q_\perp)}=$$&lt;br&gt;$$(S^+F_L-S^-F_R+S^-S^+(U_R-U_L))^{(h,q_\perp)}/(S^+-S^-)$$&lt;br&gt;HLL en masa/momento NORMAL cuando S⁻&amp;lt;0&amp;lt;S⁺; transversal: contacto/upwind, NO HLL 3D.&lt;br&gt;Estados secos y ramas de onda exteriores tratados aparte; lecho con términos de fuente.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="4950" width="2940" height="513" /></mxCell><mxCell id="p12" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;12 · Residuos modales + dos etapas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;rk_stage1 / rk_stage2 · swe/dg2.cpp&lt;/font&gt;&lt;br&gt;$$U^{(1)}=U^n+\Delta tL(U^n)$$&lt;br&gt;$$U^{n+1}=\frac{1}{2}[U^n+U^{(1)}+\Delta tL(U^{(1)})]$$&lt;br&gt;En CADA etapa: reconstruir caras → flujo HLL → residuos L0/L1x/L1y.&lt;br&gt;RK2 para residuo; fricción/lluvia partidas: no afirmar orden global 2.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="5545" width="2940" height="429" /></mxCell><mxCell id="p13" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;13 · Máximos, avance, guardado y retorno&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;update_max_field / fluxstats / write_max_field · dg2::solve&lt;/font&gt;&lt;br&gt;Actualizar máximo y estadísticas; t ← t + Δt; guardar si se cruza umbral temporal.&lt;br&gt;Repetir desde «t &amp;lt; Sim_Time»; al salir escribir campo máximo .max.&lt;br&gt;Cuadros .wd y .max son profundidades numéricas; tiempo físico por cuadro no registrado.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#fff2dd;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="6056" width="2940" height="309" /></mxCell><mxCell id="p14" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;14 · Verificación de salidas y COG&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;read_depth_ascii → summarize_results → export_depth_cog · results.py&lt;/font&gt;&lt;br&gt;Validar encabezado, malla, nodata, finitud y h ≥ 0; nodata = desconocido (NO seco).&lt;br&gt;Cuadros ordenados + máximo calculado del motor; exportar COG float32 CRS métrico.&lt;br&gt;SHA256 de fuentes/destinos; límites geográficos solo para encuadre, NO reproyección del COG.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e6f4ea;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="6447" width="2940" height="309" /></mxCell><mxCell id="p15" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;15 · API privada → entrega al cliente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;RoiRunStatusView / RoiRunResultsView / RoiRunArtifactView · backend/analyses/roi_flood_runs.py&lt;/font&gt;&lt;br&gt;GET /api/flood-roi-runs/&amp;lt;uuid&amp;gt;/ : created → acquiring → preparing → running → results → succeeded.&lt;br&gt;Fallo/plazo en cualquier fase del worker → failed/timed_out; results devuelve 409 antes del éxito.&lt;br&gt;Éxito: grid/crs/nodata, frames[frame_index, time_s:null, scheduled_time_s], maximum, warnings.&lt;br&gt;artifacts URL+SHA; GET /artifacts/&amp;lt;name&amp;gt;/ solo propietario, TIFF completo + ETag; sin Range.&lt;br&gt;Sin auth 401/403; ajeno/no autorizado 404; fallos sanitizados, sin traceback ni rutas privadas.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e6f4ea;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="6838" width="2940" height="405" /></mxCell><mxCell id="p16" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b&gt;16 · LÍMITE DE IMPLEMENTACIÓN: API → frontend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#22537a&quot;&gt;JSON + TIFF COG recibidos por cliente autenticado; visualización pendiente&lt;/font&gt;&lt;br&gt;Para MapLibre: decodificar y reproyectar TIFF métrico a 3857 O crear teselas autenticadas.&lt;br&gt;NO usar URL COG como XYZ ni MapLibre image; NO hay velocidad, tiempo de llegada ni tiempo físico exacto.&lt;br&gt;Escenario sintético y exploratorio: hydraulic_accuracy_validated:false; no causalidad NISAR.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;math=1;align=left;verticalAlign=top;spacing=45;spacingTop=18;fontSize=25;fontColor=#142c42;fillColor=#e8edf5;strokeColor=#adbfce;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="7325" width="2940" height="309" /></mxCell><mxCell id="e1" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p1" target="p2"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p3" target="p4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e4" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4" target="p5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e5" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p5" target="p6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e6" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p6" target="p7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e7" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p7" target="p8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e8" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p8" target="p9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e9" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p9" target="p10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e10" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p10" target="p11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e11" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p11" target="p12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e12" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p12" target="p13"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e13" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p13" target="p14"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e14" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p14" target="p15"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e15" style="endArrow=block;endFill=1;strokeColor=#246490;strokeWidth=4;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p15" target="p16"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="loop" value="si t &amp;lt; Sim_Time: repetir" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#ca7432;strokeWidth=3;dashed=1;html=1;fontSize=23;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p13" target="p9"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="footer" value="Leyenda: azul admisión/terreno · ámbar cálculo · verde resultados/API · gris frontera frontend.  Referencias: docs/simulacion-inundacion-dg2.tex · docs/api-simulacion-roi.md." style="text;html=1;align=left;whiteSpace=wrap;fontSize=20;fontColor=#425a70;" vertex="1" parent="1"><mxGeometry as="geometry" x="230" y="7714" width="2940" height="90" /></mxCell></root></mxGraphModel></diagram></mxfile>
