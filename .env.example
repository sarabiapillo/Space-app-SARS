# Copiar a .env y completar. El archivo .env NO se sube a git.

# Django
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (PostGIS en Docker, ver docker-compose.yml)
POSTGRES_DB=terrapulse
POSTGRES_USER=terrapulse
POSTGRES_PASSWORD=cambia-esto
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# NASA Earthdata Login (descarga de NISAR y fuentes auxiliares).
# Si están las dos, tienen prioridad sobre ~/.netrc. En un servidor, mejor definirlas
# como variables de entorno del hosting; las del sistema no se sobrescriben con este archivo.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
